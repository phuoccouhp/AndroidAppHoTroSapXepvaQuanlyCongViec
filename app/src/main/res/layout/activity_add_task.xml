<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background"
    tools:context=".AddTaskActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:paddingBottom="100dp"> 

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/outline_arrow_back_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_add_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Task"
            android:textSize="32sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_back" 
            android:layout_marginTop="16dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_save_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_check_24"
            app:tint="@color/white"
            app:backgroundTint="@color/pastel_blue_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Save Task" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_task_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:hint="Task Name"
            android:padding="16dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/tv_add_task_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_categories_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Category"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_task_name" />

        <Spinner
            android:id="@+id/spinner_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/white"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_categories_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_due_date_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Due Date"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_categories" />

        <Button
            android:id="@+id/btn_set_due_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="Set Date"
            android:drawableLeft="@drawable/outline_calendar_month_24"
            android:backgroundTint="@color/white"
            android:textColor="@color/oxford_blue"
            app:layout_constraintTop_toBottomOf="@id/tv_due_date_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_set_time"
            style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="16dp"
            />

        <Button
            android:id="@+id/btn_set_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Set Time"
            android:drawableLeft="@drawable/baseline_access_time_24"
            android:backgroundTint="@color/white"
            android:textColor="@color/oxford_blue"
            app:layout_constraintTop_toTopOf="@id/btn_set_due_date"
            app:layout_constraintStart_toEndOf="@id/btn_set_due_date"
            app:layout_constraintEnd_toEndOf="parent"
            style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="16dp"
            />

        <TextView
            android:id="@+id/tv_reminder_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Reminder &amp; Sound"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_set_due_date" />

        <Button
            android:id="@+id/btn_set_reminder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="Reminder OFF"
            android:drawableLeft="@drawable/baseline_notifications_24"
            android:backgroundTint="@color/white"
            android:textColor="@color/oxford_blue"
            app:layout_constraintTop_toBottomOf="@id/tv_reminder_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_select_ringtone"
            style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btn_select_ringtone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Select Sound"
            android:backgroundTint="@color/white"
            android:textColor="@color/oxford_blue"
            app:layout_constraintTop_toTopOf="@id/btn_set_reminder"
            app:layout_constraintStart_toEndOf="@id/btn_set_reminder"
            app:layout_constraintEnd_toEndOf="parent"
            style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="16dp" />

        <TextView
            android:id="@+id/tv_vibration_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Vibration"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_set_reminder" />

        <Spinner
            android:id="@+id/spinner_vibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/white"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_vibration_title"/>
        
        <TextView
            android:id="@+id/tv_notes_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Notes"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_vibration" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="120dp"
            android:hint="Add notes..."
            android:textColor="@android:color/black"
            android:gravity="top"
            android:padding="16dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/tv_notes_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>