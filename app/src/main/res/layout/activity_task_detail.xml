<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FF"
    tools:context=".task.TaskDetailActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/outline_arrow_back_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task detail"
            android:textSize="30sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            android:layout_marginTop="0dp"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTaskName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Name task"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTaskName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:hint="Task..."
            android:padding="16dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/tvTaskName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Task"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etTaskName" />

        <Spinner
            android:id="@+id/spinnerCategories"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/white"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTags"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Due Date"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerCategories" />

        <Button
            android:id="@+id/btnSetDueDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:text="Set Date"
            android:drawableLeft="@drawable/outline_calendar_month_24"
            android:backgroundTint="@color/white"
            android:textColor="@color/oxford_blue"
            app:layout_constraintTop_toBottomOf="@id/tvDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSetTime"
            style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnSetTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Set Time"
            android:drawableLeft="@drawable/baseline_access_time_24"
            android:backgroundTint="@color/white"
            android:textColor="@color/oxford_blue"
            app:layout_constraintTop_toTopOf="@id/btnSetDueDate"
            app:layout_constraintStart_toEndOf="@id/btnSetDueDate"
            app:layout_constraintEnd_toEndOf="parent"
            style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="16dp" />

        <TextView
            android:id="@+id/tvReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reminder &amp; Sound"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSetDueDate" />

        <Button
            android:id="@+id/btnSetReminder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:text="Reminder OFF"
            android:drawableLeft="@drawable/baseline_notifications_24"
            android:backgroundTint="@color/white"
            android:textColor="@color/oxford_blue"
            app:layout_constraintTop_toBottomOf="@id/tvReminder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSelectRingtone"
            style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnSelectRingtone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Select Sound"
            android:backgroundTint="@color/white"
            android:textColor="@color/oxford_blue"
            app:layout_constraintTop_toTopOf="@id/btnSetReminder"
            app:layout_constraintStart_toEndOf="@id/btnSetReminder"
            app:layout_constraintEnd_toEndOf="parent"
            style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="16dp" />

        <TextView
            android:id="@+id/tvVibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Vibration"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSetReminder" />

        <Spinner
            android:id="@+id/spinnerVibration"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/white"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvVibration"/>

        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Notes"
            android:textSize="22sp"
            android:fontFamily="@font/smoochsans_bold"
            android:textColor="@color/oxford_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerVibration" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:hint="Add notes..."
            android:minHeight="130dp"
            android:padding="16dp"
            android:gravity="top"
            android:background="@drawable/bg_dialog_description"
            android:backgroundTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/tvNotes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSaveTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_check_24"
            app:tint="@color/white"
            app:backgroundTint="@color/pastel_blue_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Save Task" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>