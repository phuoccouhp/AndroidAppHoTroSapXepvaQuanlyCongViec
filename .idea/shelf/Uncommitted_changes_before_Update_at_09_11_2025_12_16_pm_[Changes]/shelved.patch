+            if (pos != RecyclerView.NO_POSITION) {
+                Task taskToDelete = taskList.get(pos);
+                deleteClickListener.onDeleteClick(taskToDelete);
+            }
+        });
+
+
+        int iconResId;
+        switch (task.getCategory()) {
+            case "Work":
