<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:padding="12dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imgViewAvatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_ai_avatar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvChatName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Chat 1"
        android:textColor="@color/text_color_dark"
        android:textSize="24sp"
        android:fontFamily="@font/smoochsans_bold"
        app:layout_constraintStart_toEndOf="@+id/imgViewAvatar"
        app:layout_constraintEnd_toStartOf="@id/tvTimestamp"
        app:layout_constraintTop_toTopOf="@+id/imgViewAvatar"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvLastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="This is the last message..."
        android:textColor="@color/text_color_dark"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/tvChatName"
        app:layout_constraintEnd_toStartOf="@id/tvTimestamp"
        app:layout_constraintBottom_toBottomOf="@id/imgViewAvatar"/>

    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5m ago"
        android:textColor="@color/text_color_dark"
        android:textSize="16sp"
        android:paddingStart="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvChatName"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
