<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home.HomeFragment">

    <ImageButton
        android:id="@+id/btnHistory"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/baseline_menu_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome To Taskify"
        android:textSize="30sp"
        android:textColor="@color/oxford_blue"
        android:textAlignment="center"
        android:fontFamily="@font/smoochsans_bold"
        app:layout_constraintTop_toTopOf="@id/btnHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnHistory"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroup"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnTabHome"
        app:layout_constraintTop_toBottomOf="@id/btnHistory">

        <Button
            android:id="@+id/btnTabHome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Home"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/pastel_blue_dark"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/btnTabAchievements"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Awards"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cornerRadius="20dp"/>

        <Button
            android:id="@+id/btnTabAnalysis"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Analysis"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cornerRadius="20dp"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/toggleGroup"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>