<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".DocumentsFragment">

    <ImageButton
        android:id="@+id/btnHistory"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/baseline_menu_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back"
        android:textSize="30sp"
        android:textColor="@color/oxford_blue"
        android:textAlignment="center"
        android:fontFamily="@font/smoochsans_bold"
        app:layout_constraintTop_toTopOf="@id/btnHistory"
        app:layout_constraintBottom_toBottomOf="@id/btnHistory"
        app:layout_constraintStart_toEndOf="@id/btnHistory"
        app:layout_constraintEnd_toStartOf="@id/btnNotifications" />

    <ImageButton
        android:id="@+id/btnNotifications"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/baseline_person_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnHistory" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnHistory"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingBottom="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#D6E4FF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage your\ntime here"
                        android:textSize="20sp"
                        android:textColor="@color/oxford_blue"
                        android:fontFamily="@font/smoochsans_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/home_activity"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tags:"
                android:textSize="22sp"
                android:fontFamily="@font/smoochsans_bold"
                android:textColor="@color/oxford_blue"
                android:layout_marginTop="24dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp">
                    <ImageButton
                        android:id="@+id/btnWork"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/baseline_work_24"
                        android:background="@drawable/bg_dialog_rounded"
                        android:backgroundTint="@color/white"
                        app:tint="#FF9800" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Work"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp">

                    <ImageButton
                        android:id="@+id/btnPersonal"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/baseline_person_24"
                        android:background="@drawable/bg_dialog_rounded"
                        android:backgroundTint="@color/white"
                        app:tint="#2196F3"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp">
                    <ImageButton
                        android:id="@+id/btnHealth"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/baseline_health_24"
                        android:background="@drawable/bg_dialog_rounded"
                        android:backgroundTint="@color/white"
                        app:tint="#E91E63"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp">
                    <ImageButton
                        android:id="@+id/btnShopping"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/baseline_shopping_cart_24"
                        android:background="@drawable/bg_dialog_rounded"
                        android:backgroundTint="@color/white"
                        app:tint="#4CAF50"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shopping"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp">
                    <ImageButton
                        android:id="@+id/btnAll"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/baseline_search_24"
                        android:background="@drawable/bg_dialog_rounded"
                        android:backgroundTint="@color/white"
                        app:tint="#673AB7"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTaskToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Task for Today:"
                android:textSize="22sp"
                android:fontFamily="@font/smoochsans_bold"
                android:textColor="@color/oxford_blue"
                android:layout_marginTop="24dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTaskToday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_task" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvTaskFuture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Task for Future"
                android:textSize="22sp"
                android:fontFamily="@font/smoochsans_bold"
                android:textColor="@color/oxford_blue"
                android:layout_marginTop="24dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTaskFuture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_task" />

            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
