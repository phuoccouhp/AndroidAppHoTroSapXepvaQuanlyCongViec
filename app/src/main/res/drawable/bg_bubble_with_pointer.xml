<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The main speech bubble body -->
    <item android:right="8dp"> <!-- Leave space for the pointer -->
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- The triangle pointer, rotated and positioned on the right edge -->
    <item
        android:width="16dp"
        android:height="16dp"
        android:gravity="right|center_vertical">
        <rotate
            android:fromDegrees="45"
            android:pivotX="100%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
            </shape>
        </rotate>
    </item>
</layer-list>