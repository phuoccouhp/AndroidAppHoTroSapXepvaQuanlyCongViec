<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FF"
    tools:context=".TaskDetailFragment" 
    android:padding="24dp">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_confirm_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_check_24"
        app:tint="@color/white"
        app:backgroundTint="@color/pastel_blue_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Confirm Changes" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_cancel_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_close_24"
        app:tint="@color/white"
        app:backgroundTint="@color/material_grey_600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="Cancel Changes" />

    <TextView
        android:id="@+id/tv_task_detail_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Task"
        android:textSize="32sp"
        android:fontFamily="@font/smoochsans_bold"
        android:textColor="@color/oxford_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_task_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Task Name"
        android:background="@drawable/bg_dialog_rounded"
        android:backgroundTint="@color/white"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_task_detail_title" />

    <EditText
        android:id="@+id/et_task_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Task Detail"
        android:background="@drawable/bg_dialog_rounded"
        android:backgroundTint="@color/white"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_task_name" />

    <Spinner
        android:id="@+id/spinner_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dialog_rounded"
        android:backgroundTint="@color/white"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_task_detail" />

    <Button
        android:id="@+id/btn_pick_date"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/white"
        android:drawableStart="@drawable/outline_calendar_month_24"
        android:text="Pick Date"
        android:textColor="@color/oxford_blue"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toStartOf="@id/btn_pick_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinner_categories" />

    <Button
        android:id="@+id/btn_pick_time"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:drawableStart="@drawable/baseline_access_time_24"
        android:text="Pick Time"
        android:textColor="@color/oxford_blue"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_pick_date"
        app:layout_constraintTop_toTopOf="@id/btn_pick_date" />

    <Button
        android:id="@+id/btn_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/white"
        android:drawableStart="@drawable/baseline_notifications_24"
        android:text="Set Reminder"
        style="?attr/materialButtonOutlinedStyle"
        app:cornerRadius="16dp"
        android:textColor="@color/oxford_blue"
        app:layout_constraintTop_toBottomOf="@id/btn_pick_date" />

    <EditText
        android:id="@+id/et_notes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dialog_rounded"
        android:backgroundTint="@color/white"
        android:gravity="top"
        android:hint="Notes"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/btn_confirm_task"
        app:layout_constraintTop_toBottomOf="@id/btn_reminder" />

</androidx.constraintlayout.widget.ConstraintLayout>